          singleSel.value = existingExp.payers[0].memberId;
        }
      }

      // Build Split Member Rows
      const splitList = document.getElementById('splitMembersList');
      splitList.innerHTML = members.map(m => {
        const existingSplit = existingExp
          ? existingExp.splits.find(s => s.memberId === m.id)
          : null;
        const isChecked = existingExp ? Boolean(existingSplit) : true;
        const rawVal = existingSplit ? (existingSplit.rawVal ?? existingSplit.amount) : '';

        return `
          <div class="flex items-center justify-between gap-2" style="background:#ffffff;padding:8px 10px;border-radius:12px;border:1px solid var(--border-color);">
            <label class="flex items-center gap-2 flex-1" style="cursor:pointer;">
              <input type="checkbox" class="split-member-chk" data-member-id="${m.id}" ${isChecked ? 'checked' : ''} onchange="recalculateSplitUI()" style="width:17px;height:17px;accent-color:var(--primary);" />
              <span style="font-size:13px;font-weight:700;">${escapeHtml(m.name)}</span>
            </label>
            <div class="flex items-center gap-1-5">
              <input type="number" step="0.01" min="0" class="input split-custom-input hidden" data-member-id="${m.id}" value="${rawVal}" oninput="recalculateSplitUI()" placeholder="0" style="width:84px;padding:5px 8px;text-align:right;font-weight:700;font-size:13px;" />
              <span class="split-computed-tag tag tag-emerald" data-member-id="${m.id}" style="min-width:74px;text-align:right;">Rs. 0</span>
            </div>
