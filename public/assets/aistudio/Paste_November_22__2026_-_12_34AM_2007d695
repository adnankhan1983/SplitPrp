              ${item.notes ? `<div class="section-sub mt-1" style="font-style:italic;">"${escapeHtml(item.notes)}"</div>` : ''}
            </div>
            <div class="text-right shrink-0">
              <div style="font-size:15px;font-weight:800;color:${isStl ? '#115e59' : 'var(--text-main)'};">${formatCurrency(item.amount, currency)}</div>
              <div class="section-sub" style="font-size:11px;">${escapeHtml(item.date)}${pkrHint}</div>
            </div>
          </div>

          <div class="flex items-center justify-between gap-2 flex-wrap mt-2" style="padding-top:8px;border-top:1px solid var(--border-color);">
            <div class="flex items-center gap-1 flex-wrap">
              ${(item.splits || []).map(s => `<span class="tag" style="font-size:10px;">${escapeHtml(getContactName(s.memberId))}: ${formatCurrency(s.amount, currency)}</span>`).join('')}
