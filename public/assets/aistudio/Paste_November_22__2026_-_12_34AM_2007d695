    function setPayerMode(mode) {
      modalPayerMode = mode;
      document.getElementById('payerModeSingleBtn').classList.toggle('active', mode === 'single');
      document.getElementById('payerModeMultiBtn').classList.toggle('active', mode === 'multi');
      document.getElementById('singlePayerBox').classList.toggle('hidden', mode !== 'single');
      document.getElementById('multiPayerBox').classList.toggle('hidden', mode !== 'multi');
      validatePayersUI();
