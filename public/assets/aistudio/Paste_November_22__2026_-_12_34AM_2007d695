    function openExpenseModal(defaultGroupId = null, editExpenseId = null) {
      const gSel = document.getElementById('expGroupSelect');
      gSel.innerHTML = `<option value="DIRECT">1-on-1 Direct (No Group)</option>` +
        appState.groups.map(g => `<option value="${g.id}">${escapeHtml(g.name)}</option>`).join('');

      document.getElementById('editExpenseId').value = editExpenseId || '';
      document.getElementById('expenseModalTitle').textContent = editExpenseId ? 'Edit Expense' : 'Add Shared Expense';

      if (editExpenseId) {
        const exp = appState.expenses.find(e => e.id === editExpenseId);
        if (!exp) return;
        gSel.value = exp.groupId || 'DIRECT';
        document.getElementById('expCategorySelect').value = exp.category || 'Food & Dining';
        document.getElementById('expDescription').value = exp.description || '';
        document.getElementById('expCurrencySelect').value = exp.currency || 'PKR';
        document.getElementById('expAmount').value = exp.amount || '';
        document.getElementById('expDate').value = exp.date || new Date().toISOString().slice(0, 10);
        document.getElementById('expRecurring').value = exp.recurring || 'One-time';
        document.getElementById('expNotes').value = exp.notes || '';
        tempReceiptBase64 = exp.receiptImg || '';
      } else {
        gSel.value = defaultGroupId || activeGroupDetailId || 'DIRECT';
        document.getElementById('expCategorySelect').value = 'Food & Dining';
        document.getElementById('expDescription').value = '';
        document.getElementById('expCurrencySelect').value = 'PKR';
        document.getElementById('expAmount').value = '';
