    function renderAnalyticsTab() {
      const expenses = appState.expenses;
      const emptyBox = document.getElementById('analyticsEmptyBox');
      const contentBox = document.getElementById('analyticsContentBox');

      if (!expenses.length) {
        emptyBox.classList.remove('hidden');
        contentBox.classList.add('hidden');
        return;
      }

      emptyBox.classList.add('hidden');
      contentBox.classList.remove('hidden');

      const totalSpend = expenses.reduce((s, e) => s + e.amount * (appState.ratesToPKR[e.currency] || 1), 0);
      document.getElementById('kpiTotalSpend').textContent = formatPKR(totalSpend);
      document.getElementById('kpiBillCount').textContent = `${expenses.length} shared bill${expenses.length === 1 ? '' : 's'}`;

      const catTotals = {};
      expenses.forEach(e => {
        const pkr = e.amount * (appState.ratesToPKR[e.currency] || 1);
        catTotals[e.category] = (catTotals[e.category] || 0) + pkr;
      });

      const sortedCats = Object.entries(catTotals).sort((a, b) => b[1] - a[1]);
      if (sortedCats.length) {
        document.getElementById('kpiTopCat').textContent = sortedCats[0][0];
        const pct = totalSpend > 0 ? Math.round((sortedCats[0][1] / totalSpend) * 100) : 0;
        document.getElementById('kpiTopCatShare').textContent = `${pct}% (${formatPKR(sortedCats[0][1])})`;
      }

      // Pure SVG Donut Chart
      const radius = 52;
      const circumference = 2 * Math.PI * radius;
      let offset = 0;
      const circles = sortedCats.map(([cat, val]) => {
        const slice = totalSpend > 0 ? (val / totalSpend) * circumference : 0;
        const color = CATEGORY_COLORS[cat] || '#64748b';
        const c = `<circle r="${radius}" cx="75" cy="75" fill="transparent" stroke="${color}" stroke-width="22" stroke-dasharray="${slice} ${circumference - slice}" stroke-dashoffset="-${offset}" />`;
        offset += slice;
        return c;
      }).join('');

      document.getElementById('categoryDonutWrap').innerHTML = `
        <svg viewBox="0 0 150 150" width="145" height="145" style="transform:rotate(-90deg);">
          ${circles}
        </svg>
      `;

      document.getElementById('categoryLegendWrap').innerHTML = sortedCats.map(([cat, val]) => {
        const pct = totalSpend > 0 ? Math.round((val / totalSpend) * 100) : 0;
        const color = CATEGORY_COLORS[cat] || '#64748b';
        return `
          <div class="flex items-center justify-between gap-2" style="font-size:12px;">
            <div class="flex items-center gap-1-5 truncate">
              <span style="width:10px;height:10px;border-radius:3px;background:${color};flex-shrink:0;"></span>
              <span class="truncate" style="font-weight:600;">${escapeHtml(cat)}</span>
            </div>
            <span class="shrink-0" style="font-weight:800;">${pct}% <span style="color:var(--text-muted);font-weight:500;">(${formatPKR(val)})</span></span>
          </div>
        `;
      }).join('');

      // Paid vs Fair Share Member Comparison
      const paidMap = {};
      const shareMap = {};
      appState.contacts.forEach(c => { paidMap[c.id] = 0; shareMap[c.id] = 0; });

      expenses.forEach(e => {
        const rate = appState.ratesToPKR[e.currency] || 1;
        e.payers.forEach(p => { paidMap[p.memberId] = (paidMap[p.memberId] || 0) + p.amount * rate; });
        e.splits.forEach(s => { shareMap[s.memberId] = (shareMap[s.memberId] || 0) + s.amount * rate; });
      });

      const maxVal = Math.max(1, ...Object.values(paidMap), ...Object.values(shareMap));
      document.getElementById('memberComparisonWrap').innerHTML = appState.contacts.map(c => {
        const paid = paidMap[c.id] || 0;
        const share = shareMap[c.id] || 0;
        const paidW = Math.round((paid / maxVal) * 100);
        const shareW = Math.round((share / maxVal) * 100);
        return `
          <div>
            <div class="flex justify-between" style="font-size:12px;font-weight:700;">
              <span>${escapeHtml(c.name)}</span>
              <span style="color:var(--text-secondary);">Paid <b style="color:#047857;">${formatPKR(paid)}</b> • Share <b style="color:#0284c7;">${formatPKR(share)}</b></span>
            </div>
            <div class="bar-track"><div class="bar-fill-emerald" style="width:${paidW}%;"></div></div>
            <div class="bar-track"><div class="bar-fill-sky" style="width:${shareW}%;"></div></div>
          </div>
        `;
      }).join('');

      // Last 6 Months Trend Bar Chart
      const months = [];
      for (let i = 5; i >= 0; i--) {
        const d = new Date();
        d.setMonth(d.getMonth() - i);
        months.push({
          ym: d.toISOString().slice(0, 7),
          label: d.toLocaleString('en-US', { month: 'short' }),
          total: 0
        });
      }
      expenses.forEach(e => {
        const ym = (e.date || '').slice(0, 7);
        const bucket = months.find(m => m.ym === ym);
        if (bucket) bucket.total += e.amount * (appState.ratesToPKR[e.currency] || 1);
      });

      const maxMonth = Math.max(1, ...months.map(m => m.total));
      document.getElementById('monthlyTrendWrap').innerHTML = `
        <div class="trend-grid">
          ${months.map(m => {
            const hPct = m.total > 0 ? Math.max(8, Math.round((m.total / maxMonth) * 100)) : 5;
            const lbl = m.total >= 1000 ? Math.round(m.total / 1000) + 'k' : Math.round(m.total);
            return `
              <div class="trend-col">
                <span style="font-size:10px;font-weight:700;color:var(--text-secondary);margin-bottom:4px;">${lbl}</span>
                <div class="trend-bar" style="height:${hPct}%;"></div>
                <span style="font-size:11px;font-weight:700;color:var(--text-secondary);margin-top:6px;">${m.label}</span>
              </div>
            `;
          }).join('')}
        </div>
      `;
    }

