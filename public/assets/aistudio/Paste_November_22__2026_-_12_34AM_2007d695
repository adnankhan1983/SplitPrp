  <!-- ==================== APPLICATION JAVASCRIPT ==================== -->
  <script>
    /**
     * SplitPro Offline Storage & Zero-Predefined-Data Architecture
     * Starts completely empty with only the default user ("You").
     */
    const STORAGE_KEY = 'splitpro_offline_clean_v1';
    const DEFAULT_USER_ID = 'user_you';

    const CATEGORY_COLORS = {
      'Food & Dining': '#059669',
      'Groceries': '#10b981',
      'Transport & Fuel': '#d97706',
      'Utilities & Bills': '#7c3aed',
      'Rent': '#0d9488',
      'Supplies & Inventory': '#0284c7',
      'Travel': '#2563eb',
      'Other': '#64748b'
    };

    const CURRENCY_SYMBOLS = {
      PKR: 'Rs.',
      USD: '$',
      AED: 'AED',
      SAR: 'SAR',
      GBP: '£'
    };

    function createBlankState() {
      return {
        currentUserId: DEFAULT_USER_ID,
        ratesToPKR: {
          PKR: 1,
          USD: 278.5,
          AED: 75.8,
          SAR: 74.2,
          GBP: 354.0
        },
        contacts: [
          { id: DEFAULT_USER_ID, name: 'You', phone: '', note: 'Default Account' }
        ],
        groups: [],
        expenses: [],
        settlements: []
      };
    }

    let appState = loadState();
    let activeTab = 'dashboard';
    let activeGroupDetailId = null;
    let modalPayerMode = 'single';
    let modalSplitMode = 'equal';
    let tempReceiptBase64 = '';
    let pendingConfirmCallback = null;

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && Array.isArray(parsed.contacts) && Array.isArray(parsed.groups) && Array.isArray(parsed.expenses)) {
            if (!Array.isArray(parsed.settlements)) parsed.settlements = [];
            if (!parsed.contacts.length) {
              parsed.contacts = [{ id: DEFAULT_USER_ID, name: 'You', phone: '', note: 'Default Account' }];
              parsed.currentUserId = DEFAULT_USER_ID;
            }
            return parsed;
          }
        }
      } catch (err) {
        console.error('Storage read error:', err);
      }
      const blank = createBlankState();
      saveState(blank);
      return blank;
    }

    function saveState(state = appState) {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (err) {
        showToast('Storage limit reached. Remove large receipt images.');
      }
    }

    // ==================== FORMATTERS & HELPERS ====================
    function formatPKR(val) {
      const num = Math.round((Number(val) || 0) * 100) / 100;
      const absStr = Math.abs(num).toLocaleString('en-PK', {
        minimumFractionDigits: num % 1 === 0 ? 0 : 2,
        maximumFractionDigits: 2
      });
      return (num < 0 ? '-Rs. ' : 'Rs. ') + absStr;
    }

    function formatCurrency(val, currency = 'PKR') {
      const sym = CURRENCY_SYMBOLS[currency] || currency;
      const num = Math.round((Number(val) || 0) * 100) / 100;
      return `${sym} ${num.toLocaleString('en-US', {
        minimumFractionDigits: num % 1 === 0 ? 0 : 2,
        maximumFractionDigits: 2
      })}`;
    }

    function getContactName(id) {
      const c = appState.contacts.find(x => x.id === id);
      return c ? c.name : 'Unknown';
    }

    function getGroupName(id) {
      if (!id || id === 'DIRECT') return '1-on-1 Direct';
      const g = appState.groups.find(x => x.id === id);
      return g ? g.name : '1-on-1 Direct';
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function showToast(msg) {
      const box = document.getElementById('toastBox');
      box.textContent = msg;
      box.classList.remove('hidden');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => box.classList.add('hidden'), 2700);
    }

    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    function openConfirmDialog(title, message, onConfirm) {
      document.getElementById('confirmModalTitle').textContent = title;
      document.getElementById('confirmModalMessage').textContent = message;
      pendingConfirmCallback = onConfirm;
      document.getElementById('confirmModal').classList.remove('hidden');
    }

    document.getElementById('confirmModalYesBtn').onclick = function() {
      closeModal('confirmModal');
      if (typeof pendingConfirmCallback === 'function') {
        pendingConfirmCallback();
        pendingConfirmCallback = null;
      }
    };

    // ==================== UNIFIED LEDGER & DEBT SIMPLIFICATION ====================
    function getCombinedLedger(groupIdFilter = null) {
      const expItems = appState.expenses.map(e => ({ ...e, entryType: 'expense' }));
      const stlItems = appState.settlements.map(s => ({
        ...s,
        entryType: 'settlement',
        payers: [{ memberId: s.from, amount: s.amount }],
        splits: [{ memberId: s.to, amount: s.amount }]
      }));

      let combined = [...expItems, ...stlItems];
      if (groupIdFilter && groupIdFilter !== 'ALL') {
        combined = combined.filter(item => (item.groupId || 'DIRECT') === groupIdFilter);
      }
      return combined.sort((a, b) => new Date(b.date) - new Date(a.date));
    }

    /**
     * Net Balance Engine (converted to PKR)
     * Positive = person paid more than their share (is owed money)
     * Negative = person paid less than their share (owes money)
     */
    function calculateNetBalances(entries) {
      const net = {};
      appState.contacts.forEach(c => { net[c.id] = 0; });

      entries.forEach(item => {
        const rate = appState.ratesToPKR[item.currency || 'PKR'] || 1;
        (item.payers || []).forEach(p => {
          if (net[p.memberId] === undefined) net[p.memberId] = 0;
          net[p.memberId] += (Number(p.amount) || 0) * rate;
        });
        (item.splits || []).forEach(s => {
          if (net[s.memberId] === undefined) net[s.memberId] = 0;
          net[s.memberId] -= (Number(s.amount) || 0) * rate;
        });
      });

      Object.keys(net).forEach(k => {
        net[k] = Math.round(net[k] * 100) / 100;
        if (Math.abs(net[k]) < 0.5) net[k] = 0;
      });
      return net;
    }

    /**
     * Greedy Min-Cash-Flow Debt Simplification
     */
    function simplifyDebts(netMap) {
      const debtors = [];
      const creditors = [];

      Object.entries(netMap).forEach(([memberId, bal]) => {
        if (bal < -0.5) debtors.push({ memberId, amount: Math.abs(bal) });
        else if (bal > 0.5) creditors.push({ memberId, amount: bal });
      });

      debtors.sort((a, b) => b.amount - a.amount);
      creditors.sort((a, b) => b.amount - a.amount);

      const transfers = [];
      let i = 0, j = 0;

      while (i < debtors.length && j < creditors.length) {
        const amt = Math.min(debtors[i].amount, creditors[j].amount);
        if (amt >= 1) {
          transfers.push({
            from: debtors[i].memberId,
            to: creditors[j].memberId,
            amount: Math.round(amt)
          });
        }
        debtors[i].amount -= amt;
        creditors[j].amount -= amt;
        if (debtors[i].amount < 0.5) i++;
        if (creditors[j].amount < 0.5) j++;
      }
      return transfers;
    }

    // ==================== MASTER RENDER ====================
    function renderAll() {
      populateHeaderUserSelect();
      renderDashboardTab();
      renderGroupsTab();
      renderActivityTab();
      renderAnalyticsTab();
      renderSettingsTab();
    }

    function populateHeaderUserSelect() {
      const sel = document.getElementById('currentUserSelect');
      sel.innerHTML = appState.contacts.map(c =>
        `<option value="${c.id}" ${c.id === appState.currentUserId ? 'selected' : ''}>👤 ${escapeHtml(c.name)}</option>`
      ).join('');
    }

    function renderDashboardTab() {
      const allEntries = getCombinedLedger('ALL');
      const net = calculateNetBalances(allEntries);
      const transfers = simplifyDebts(net);
      const me = appState.currentUserId;

      let owedToMe = 0;
      let iOwe = 0;
      transfers.forEach(tx => {
        if (tx.to === me) owedToMe += tx.amount;
        if (tx.from === me) iOwe += tx.amount;
      });

      const myNet = net[me] || 0;
      const netEl = document.getElementById('netBalanceDisplay');
      const badgeEl = document.getElementById('netStatusBadge');

      if (myNet > 0.5) {
        netEl.textContent = `+${formatPKR(myNet)}`;
        netEl.style.color = '#059669';
        badgeEl.textContent = 'You Get Back';
        badgeEl.className = 'status-pill positive';
      } else if (myNet < -0.5) {
        netEl.textContent = formatPKR(myNet);
        netEl.style.color = '#e11d48';
        badgeEl.textContent = 'You Owe';
        badgeEl.className = 'status-pill negative';
      } else {
        netEl.textContent = 'Rs. 0';
        netEl.style.color = '#0f172a';
        badgeEl.textContent = 'All Settled';
        badgeEl.className = 'status-pill';
      }

      document.getElementById('youAreOwedDisplay').textContent = formatPKR(owedToMe);
      document.getElementById('youOweDisplay').textContent = formatPKR(iOwe);

      const isCompletelyEmpty = appState.groups.length === 0 && allEntries.length === 0;
