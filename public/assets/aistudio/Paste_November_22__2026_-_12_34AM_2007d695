    function setSplitMode(mode) {
      modalSplitMode = mode;
      document.querySelectorAll('.split-mode-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.split === mode);
      });
      document.querySelectorAll('.split-custom-input').forEach(inp => {
        inp.classList.toggle('hidden', mode === 'equal');
        if (mode === 'shares' && !inp.value) inp.value = '1';
      });
      recalculateSplitUI();
