    function validatePayersUI() {
      const total = parseFloat(document.getElementById('expAmount').value) || 0;
      const currency = document.getElementById('expCurrencySelect').value;
      const msgEl = document.getElementById('payerValidationMsg');
      if (modalPayerMode !== 'multi') return;

      let paidSum = 0;
      document.querySelectorAll('.multi-payer-input').forEach(inp => {
        paidSum += parseFloat(inp.value) || 0;
      });
      const diff = Math.round((total - paidSum) * 100) / 100;
      if (Math.abs(diff) < 0.01) {
        msgEl.style.color = '#059669';
        msgEl.textContent = `✓ Total Paid matches ${formatCurrency(total, currency)}`;
      } else {
        msgEl.style.color = '#e11d48';
        msgEl.textContent = diff > 0
          ? `${formatCurrency(diff, currency)} remaining to assign`
          : `Over-assigned by ${formatCurrency(Math.abs(diff), currency)}`;
      }
    }

    function recalculateSplitUI() {
      const total = parseFloat(document.getElementById('expAmount').value) || 0;
      const currency = document.getElementById('expCurrencySelect').value;
      const rate = appState.ratesToPKR[currency] || 1;

      const hintEl = document.getElementById('pkrConversionHint');
      if (currency !== 'PKR' && total > 0) {
        hintEl.classList.remove('hidden');
        hintEl.textContent = `Converted Ledger Value: ${formatPKR(total * rate)} (Rate: 1 ${currency} = ${rate} PKR)`;
      } else {
        hintEl.classList.add('hidden');
      }

      validatePayersUI();

      const checkedIds = [];
      document.querySelectorAll('.split-member-chk').forEach(chk => {
        if (chk.checked) checkedIds.push(chk.dataset.memberId);
      });

      const badge = document.getElementById('splitValidationBadge');
      const computedMap = {};

      if (!checkedIds.length) {
        badge.className = 'tag';
        badge.style.background = 'var(--danger-light)';
        badge.style.color = 'var(--danger)';
        badge.textContent = 'Select ≥ 1 person';
      } else if (modalSplitMode === 'equal') {
        const each = Math.round((total / checkedIds.length) * 100) / 100;
        let running = 0;
        checkedIds.forEach((id, idx) => {
          if (idx === checkedIds.length - 1) {
            computedMap[id] = Math.max(0, Math.round((total - running) * 100) / 100);
          } else {
            computedMap[id] = each;
            running += each;
          }
        });
        badge.className = 'tag tag-emerald';
        badge.style.background = '';
        badge.style.color = '';
        badge.textContent = `${formatCurrency(each, currency)} / person`;
      } else if (modalSplitMode === 'exact') {
        let sum = 0;
        checkedIds.forEach(id => {
          const val = parseFloat(document.querySelector(`.split-custom-input[data-member-id="${id}"]`)?.value) || 0;
          computedMap[id] = val;
          sum += val;
        });
        const diff = Math.round((total - sum) * 100) / 100;
        if (Math.abs(diff) < 0.02) {
          badge.className = 'tag tag-emerald';
          badge.style.background = '';
          badge.style.color = '';
          badge.textContent = '✓ Exact Match';
        } else {
          badge.className = 'tag';
          badge.style.background = 'var(--danger-light)';
          badge.style.color = 'var(--danger)';
          badge.textContent = `${diff > 0 ? '+' : ''}${formatCurrency(diff, currency)} left`;
        }
      } else if (modalSplitMode === 'percent') {
        let pctSum = 0;
        checkedIds.forEach(id => {
          const pct = parseFloat(document.querySelector(`.split-custom-input[data-member-id="${id}"]`)?.value) || 0;
          pctSum += pct;
          computedMap[id] = Math.round(((total * pct) / 100) * 100) / 100;
        });
        const diff = Math.round((100 - pctSum) * 100) / 100;
        if (Math.abs(diff) < 0.05) {
          badge.className = 'tag tag-emerald';
          badge.style.background = '';
          badge.style.color = '';
          badge.textContent = '✓ 100% Allocated';
        } else {
          badge.className = 'tag';
          badge.style.background = 'var(--danger-light)';
          badge.style.color = 'var(--danger)';
          badge.textContent = `${diff}% remaining`;
        }
      } else if (modalSplitMode === 'shares') {
        let totalShares = 0;
        const shareVals = {};
        checkedIds.forEach(id => {
          const sh = parseFloat(document.querySelector(`.split-custom-input[data-member-id="${id}"]`)?.value) || 0;
          shareVals[id] = sh;
          totalShares += sh;
        });
        checkedIds.forEach(id => {
          computedMap[id] = totalShares > 0
            ? Math.round(((total * shareVals[id]) / totalShares) * 100) / 100
            : 0;
        });
        badge.className = 'tag tag-emerald';
        badge.style.background = '';
        badge.style.color = '';
        badge.textContent = `Total: ${totalShares} shares`;
      }

      document.querySelectorAll('.split-computed-tag').forEach(tag => {
        const id = tag.dataset.memberId;
        const amt = computedMap[id] || 0;
        tag.textContent = formatCurrency(amt, currency);
      });
    }

    function saveExpense() {
      const description = document.getElementById('expDescription').value.trim();
      const amount = parseFloat(document.getElementById('expAmount').value) || 0;
      const currency = document.getElementById('expCurrencySelect').value;
      const groupId = document.getElementById('expGroupSelect').value;
      const category = document.getElementById('expCategorySelect').value;
      const date = document.getElementById('expDate').value || new Date().toISOString().slice(0, 10);
      const recurring = document.getElementById('expRecurring').value;
      const notes = document.getElementById('expNotes').value.trim();
      const editId = document.getElementById('editExpenseId').value;

      if (!description) {
        showToast('Please enter a bill description.');
        return;
      }
      if (amount <= 0) {
        showToast('Please enter an amount greater than 0.');
        return;
      }

      // Collect payers
      let payers = [];
      if (modalPayerMode === 'single') {
        const payerId = document.getElementById('singlePayerSelect').value;
        payers = [{ memberId: payerId, amount }];
      } else {
        let paidSum = 0;
        document.querySelectorAll('.multi-payer-input').forEach(inp => {
          const val = parseFloat(inp.value) || 0;
          if (val > 0) {
            payers.push({ memberId: inp.dataset.payerId, amount: val });
            paidSum += val;
          }
        });
        if (Math.abs(amount - paidSum) > 0.05) {
          showToast('Multi-payer amounts must equal the total bill.');
          return;
        }
      }

      // Collect splits
      const checkedIds = [];
      document.querySelectorAll('.split-member-chk').forEach(chk => {
        if (chk.checked) checkedIds.push(chk.dataset.memberId);
      });
      if (!checkedIds.length) {
        showToast('Select at least one person to split with.');
        return;
      }

      let splits = [];
      if (modalSplitMode === 'equal') {
        const each = Math.round((amount / checkedIds.length) * 100) / 100;
        let running = 0;
        checkedIds.forEach((id, idx) => {
          const shareAmt = idx === checkedIds.length - 1
            ? Math.max(0, Math.round((amount - running) * 100) / 100)
            : each;
          running += each;
          splits.push({ memberId: id, amount: shareAmt, rawVal: shareAmt });
        });
      } else if (modalSplitMode === 'exact') {
        let sum = 0;
        checkedIds.forEach(id => {
          const val = parseFloat(document.querySelector(`.split-custom-input[data-member-id="${id}"]`)?.value) || 0;
          sum += val;
          splits.push({ memberId: id, amount: val, rawVal: val });
        });
        if (Math.abs(amount - sum) > 0.05) {
          showToast('Exact split amounts must add up to total.');
          return;
        }
      } else if (modalSplitMode === 'percent') {
        let pctSum = 0;
        checkedIds.forEach(id => {
          const pct = parseFloat(document.querySelector(`.split-custom-input[data-member-id="${id}"]`)?.value) || 0;
          pctSum += pct;
          const shareAmt = Math.round(((amount * pct) / 100) * 100) / 100;
          splits.push({ memberId: id, amount: shareAmt, rawVal: pct });
        });
        if (Math.abs(100 - pctSum) > 0.1) {
          showToast('Percentages must add up to 100%.');
          return;
        }
      } else if (modalSplitMode === 'shares') {
        let totalShares = 0;
        const rawMap = {};
        checkedIds.forEach(id => {
          const sh = parseFloat(document.querySelector(`.split-custom-input[data-member-id="${id}"]`)?.value) || 0;
          rawMap[id] = sh;
          totalShares += sh;
        });
        if (totalShares <= 0) {
          showToast('Total shares must be greater than 0.');
          return;
        }
        checkedIds.forEach(id => {
          const shareAmt = Math.round(((amount * rawMap[id]) / totalShares) * 100) / 100;
          splits.push({ memberId: id, amount: shareAmt, rawVal: rawMap[id] });
        });
      }

      const record = {
        id: editId || ('exp_' + Date.now()),
        groupId: groupId || 'DIRECT',
        category,
        description,
        currency,
        amount,
        date,
        recurring,
        notes,
        splitMode: modalSplitMode,
        payers,
        splits,
        receiptImg: tempReceiptBase64 || ''
      };

      if (editId) {
        const idx = appState.expenses.findIndex(e => e.id === editId);
        if (idx !== -1) appState.expenses[idx] = record;
        showToast('Expense updated!');
      } else {
        appState.expenses.unshift(record);
        showToast('Expense added!');
      }

      saveState();
      closeModal('expenseModal');
      renderAll();
    }

    // ==================== RECEIPT COMPRESSION & LIGHTBOX ====================
    function handleReceiptUpload(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          const maxDim = 720;
          let w = img.width;
          let h = img.height;
          if (w > maxDim || h > maxDim) {
            if (w > h) {
              h = Math.round((h * maxDim) / w);
              w = maxDim;
            } else {
              w = Math.round((w * maxDim) / h);
              h = maxDim;
            }
          }
          canvas.width = w;
          canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          tempReceiptBase64 = canvas.toDataURL('image/jpeg', 0.68);
          updateReceiptPreviewUI();
          showToast('Receipt compressed & attached');
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

