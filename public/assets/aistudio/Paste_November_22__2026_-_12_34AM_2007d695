              ${!isStl ? `<button onclick="openExpenseModal(null, '${item.id}')" class="btn btn-light btn-xs">Edit</button>` : ''}
              <button onclick="deleteEntry('${item.id}', '${item.entryType}')" class="btn btn-danger-soft btn-xs">Delete</button>
            </div>
          </div>
        </div>
      `;
