    function onExpenseGroupChange(existingExp = null) {
      const members = getEligibleExpenseMembers();
      document.getElementById('noOtherContactsHint').classList.toggle('hidden', members.length > 1);

      // Populate single payer dropdown
      const singleSel = document.getElementById('singlePayerSelect');
      singleSel.innerHTML = members.map(m =>
        `<option value="${m.id}" ${m.id === appState.currentUserId ? 'selected' : ''}>${escapeHtml(m.name)}</option>`
      ).join('');

      // Populate multi-payer inputs
      const multiWrap = document.getElementById('multiPayerInputs');
      multiWrap.innerHTML = members.map(m => {
        const existingPaid = existingExp
          ? (existingExp.payers.find(p => p.memberId === m.id)?.amount || '')
          : '';
        return `
          <div class="flex items-center justify-between gap-2" style="background:#ffffff;padding:7px 10px;border-radius:10px;border:1px solid var(--border-color);">
