    function exportToCSV() {
      const ledger = getCombinedLedger('ALL');
      if (!ledger.length) {
        showToast('No records available to export.');
        return;
      }
      const rows = [
        ['Date', 'Type', 'Group', 'Category', 'Description', 'Currency', 'Amount', 'PKR Equivalent', 'Paid By', 'Split Details', 'Notes']
      ];

      ledger.forEach(item => {
        const rate = appState.ratesToPKR[item.currency || 'PKR'] || 1;
        const pkrVal = Math.round(item.amount * rate * 100) / 100;
        const paidStr = (item.payers || []).map(p => `${getContactName(p.memberId)}:${p.amount}`).join(' | ');
        const splitStr = (item.splits || []).map(s => `${getContactName(s.memberId)}:${s.amount}`).join(' | ');
        const desc = item.entryType === 'settlement'
          ? `${getContactName(item.from)} paid ${getContactName(item.to)}`
          : item.description;

        rows.push([
          item.date,
          item.entryType.toUpperCase(),
          getGroupName(item.groupId),
          item.category || 'Settlement',
          desc,
          item.currency || 'PKR',
          item.amount,
          pkrVal,
          paidStr,
          splitStr,
          item.notes || ''
        ]);
      });

      const csvContent = rows.map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `SplitPro_Ledger_${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('CSV / Excel file downloaded!');
    }

    function exportJSONBackup() {
      const blob = new Blob([JSON.stringify(appState, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `SplitPro_Backup_${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('JSON backup downloaded!');
    }

    function importJSONBackup(event) {
      const file = event.target.files && event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const parsed = JSON.parse(e.target.result);
          if (!parsed || !Array.isArray(parsed.contacts) || !Array.isArray(parsed.expenses)) {
            showToast('Invalid SplitPro backup file.');
            return;
          }
          appState = parsed;
          saveState();
          renderAll();
          showToast('Backup restored successfully!');
        } catch (err) {
          showToast('Could not read JSON file.');
        }
      };
      reader.readAsText(file);
    }

    function promptClearAllData() {
      openConfirmDialog(
        'Clear All Data?',
        'This will permanently erase all groups, contacts, expenses, and settlements, resetting SplitPro to a blank slate.',
        () => {
          appState = createBlankState();
          activeGroupDetailId = null;
          saveState();
          renderAll();
          switchTab('dashboard');
          showToast('All data cleared.');
        }
      );
    }

    // ==================== WHATSAPP STATEMENT GENERATOR ====================
    function openWhatsAppModal() {
      generateWhatsAppText('bilingual');
      document.getElementById('whatsappModal').classList.remove('hidden');
    }

    function generateWhatsAppText(mode = 'bilingual') {
      document.getElementById('waLangBi').className = mode === 'bilingual' ? 'btn btn-green btn-sm' : 'btn btn-light btn-sm';
      document.getElementById('waLangEn').className = mode === 'en' ? 'btn btn-green btn-sm' : 'btn btn-light btn-sm';

      const ledger = getCombinedLedger('ALL');
      const net = calculateNetBalances(ledger);
      const transfers = simplifyDebts(net);
      const today = new Date().toISOString().slice(0, 10);

      let lines = [];
      if (mode === 'bilingual') {
        lines.push(`*📊 SplitPro Account Statement / حساب کتاب*`);
        lines.push(`Date: ${today}`);
        lines.push(`--------------------------------`);
        if (!transfers.length) {
          lines.push(`✅ All accounts are settled! / تمام حساب برابر ہیں`);
        } else {
          lines.push(`*Settlement Plan / ادائیگی کی تفصیل:*`);
          transfers.forEach((tx, idx) => {
            lines.push(`${idx + 1}. *${getContactName(tx.from)}* ➔ *${getContactName(tx.to)}*: *${formatPKR(tx.amount)}*`);
          });
        }
        lines.push(`--------------------------------`);
        lines.push(`Generated via SplitPro`);
      } else {
        lines.push(`*SplitPro Account Statement*`);
        lines.push(`Date: ${today}`);
        lines.push(`--------------------------------`);
        if (!transfers.length) {
          lines.push(`All balances are settled up!`);
        } else {
          lines.push(`*Simplified Settlement Plan:*`);
          transfers.forEach((tx, idx) => {
            lines.push(`${idx + 1}. ${getContactName(tx.from)} pays ${getContactName(tx.to)}: ${formatPKR(tx.amount)}`);
          });
        }
        lines.push(`--------------------------------`);
        lines.push(`Generated via SplitPro`);
      }

      document.getElementById('whatsappMessagePreview').value = lines.join('\n');
    }

    function copyWhatsAppText() {
      const ta = document.getElementById('whatsappMessagePreview');
      ta.select();
      ta.setSelectionRange(0, 99999);
      try {
        document.execCommand('copy');
        showToast('Statement copied to clipboard!');
      } catch (e) {
        showToast('Select text and copy manually.');
      }
    }

    function launchWhatsAppApp() {
      const text = encodeURIComponent(document.getElementById('whatsappMessagePreview').value);
      window.open(`https://wa.me/?text=${text}`, '_blank', 'noopener,noreferrer');
    }

    // ==================== INITIALIZE ON LOAD ====================
    window.addEventListener('DOMContentLoaded', () => {
      renderAll();
    });
  </script>
